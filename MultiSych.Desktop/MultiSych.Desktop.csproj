<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseRidGraph>true</UseRidGraph>
    <PublishTrimmed>false</PublishTrimmed>
    <!--
      GirCore1007: GirCore 0.8.0, native GObject tipleri üzerinde doğrudan C#
      constructor kullanımını (hem alt sınıflama hem doğrudan 'new') topluca
      deprecate ediyor. View sınıflarımız Gtk.Box/Gtk.Window/Adw.ApplicationWindow'dan
      türediği için bu desen zorunlu; GirCore'un kararlı yerine-koyma deseni henüz
      yayınlanmadı. Bu bir korektlik uyarısı değil, ileriye dönük bir migration notu.
      GirCore kararlı subclass desenini yayınladığında bu bastırma kaldırılmalı.
    -->
    <NoWarn>$(NoWarn);GirCore1007</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MultiSych.Services\MultiSych.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GirCore.Adw-1" Version="0.8.0" />
    <PackageReference Include="GirCore.Gtk-4.0" Version="0.8.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <PackageReference Include="System.IO.Packaging" Version="10.0.12" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.0" />
    <PackageReference Include="Clowd.Squirrel" Version="2.11.1" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.0.2" />
    <PackageReference Include="itext7" Version="8.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- EF Core Reflection ve Trim Optimizasyonu Korumaları -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Microsoft.EntityFrameworkCore" />
    <TrimmerRootAssembly Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <TrimmerRootAssembly Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <!-- Lokalizasyon kaynak sözlükleri (docs/KARARLAR.md K12) — Loc.cs bunları
       AppContext.BaseDirectory/Localization altından okuyor, o yüzden çıktı
       dizinine kopyalanmaları gerekiyor. -->
  <ItemGroup>
    <None Include="Localization\tr.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Localization\en.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
