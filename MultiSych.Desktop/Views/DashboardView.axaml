<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MultiSych.Desktop.ViewModels"
             x:Class="MultiSych.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <Grid Margin="20">
        <StackPanel Spacing="20">
            <TextBlock Text="Genel Bakış" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>

            <!-- Günün Yapay Zeka Özeti -->
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Text="✨ Günün Yapay Zeka Özeti" FontSize="16" Foreground="#FFD700" FontWeight="Bold"/>
                    <TextBlock Text="{Binding DailyAiSummary}" FontSize="15" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Sayaçlar -->
            <WrapPanel ItemWidth="200">
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20" CornerRadius="8" Margin="0,0,20,20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="🔗 Bağlı Hesaplar" FontSize="16" Foreground="{DynamicResource SubTextBrush}"/>
                        <TextBlock Text="{Binding TotalAccounts}" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20" CornerRadius="8" Margin="0,0,20,20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="📧 Toplam E-Posta" FontSize="16" Foreground="{DynamicResource SubTextBrush}"/>
                        <TextBlock Text="{Binding TotalEmails}" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Border>
                
                <!-- Tıklanabilir hale getirilen Takvim Etkinlikleri Kartı -->
                <Button Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20" CornerRadius="8" Margin="0,0,20,20"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                        CommandParameter="Calendar" Cursor="Hand" ToolTip.Tip="Takvim görünümüne gitmek için tıklayın">
                    <StackPanel Spacing="10">
                        <TextBlock Text="📅 Toplam Etkinlik" FontSize="16" Foreground="{DynamicResource SubTextBrush}"/>
                        <TextBlock Text="{Binding TotalEvents}" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Button>

                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20" CornerRadius="8" Margin="0,0,20,20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="📁 Toplam Dosya" FontSize="16" Foreground="{DynamicResource SubTextBrush}"/>
                        <TextBlock Text="{Binding TotalFiles}" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Anlık Durum ve Grafik Panelleri -->
            <Grid ColumnDefinitions="*, *" Margin="0,30,0,0">
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Sistem Durumu" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="{Binding IsSyncing}" Width="20" Height="20" IsVisible="{Binding IsSyncing}"/>
                            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="E-Posta Senkronizasyon Trendi" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" CornerRadius="8" Height="250">
                        <TextBlock Text="Grafik bileşeni uyumluluk güncellemesi nedeniyle geçici olarak devre dışı."
                                   Foreground="{DynamicResource SubTextBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Hesap Durumları Kartı -->
            <StackPanel Margin="0,30,0,0">
                <TextBlock Text="Bağlı Hesapların Durumu" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" CornerRadius="8">
                    <ItemsControl ItemsSource="{Binding AccountStatuses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="150, *, 150" Margin="0,5">
                                    <TextBlock Grid.Column="0" Text="{Binding Provider}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Email}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#4CAF50" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <!-- Mini Log Kartı -->
            <StackPanel Margin="0,30,0,0">
                <TextBlock Text="Son İşlemler / Mini Log" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" CornerRadius="8" MinHeight="100">
                    <ItemsControl ItemsSource="{Binding RecentLogs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{DynamicResource SubTextBrush}" FontFamily="Consolas, Monospace" Margin="0,3" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
