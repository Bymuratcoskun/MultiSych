<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MultiSych.Desktop.ViewModels"
        x:Class="MultiSych.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MultiSych - Cloud AI Platform"
        Width="1200" Height="750"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Background="{DynamicResource MainBgBrush}"
        Foreground="{DynamicResource TextBrush}">

    <!-- Tema transitions ViewModel'de sağlanacak -->

    <Grid ColumnDefinitions="260, *">
        
        <!-- Sol Menü (Sidebar) -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto, *, Auto, Auto">
                <!-- Logo / Başlık -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,30,20,30" Spacing="12">
                    <TextBlock Text="☁️" FontSize="32" VerticalAlignment="Center"/>
                    <TextBlock Text="MultiSych" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigasyon Listesi -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding NavigationItems}" Margin="10,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavigationItem">
                                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Section}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="15,12" CornerRadius="8" Margin="0,2">
                                <StackPanel Orientation="Horizontal" Spacing="15">
                                    <TextBlock Text="{Binding IconGlyph}" FontSize="20" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Label}" FontSize="16" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- AI Chat Kısayolları -->
                <StackPanel Grid.Row="2" Margin="20,20,20,30" Spacing="10">
                    <TextBlock Text="AI Assistants" FontSize="12" Foreground="{DynamicResource SubTextBrush}" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Button Command="{Binding OpenCopilotChatCommand}" Content="🤖 Microsoft Copilot" HorizontalAlignment="Stretch" Background="{DynamicResource SecondaryButtonBgBrush}" Foreground="{DynamicResource TextBrush}" CornerRadius="8" Padding="15,10"/>
                    <Button Command="{Binding OpenGeminiChatCommand}" Content="✨ Google Gemini" HorizontalAlignment="Stretch" Background="{DynamicResource SecondaryButtonBgBrush}" Foreground="{DynamicResource TextBrush}" CornerRadius="8" Padding="15,10"/>
                    <Button Command="{Binding OpenYandexChatCommand}" Content="🧠 Yandex AI" HorizontalAlignment="Stretch" Background="{DynamicResource SecondaryButtonBgBrush}" Foreground="{DynamicResource TextBrush}" CornerRadius="8" Padding="15,10"/>
                </StackPanel>

                <!-- Sistem Durumu (RAM & Sürüm) -->
                <Border Grid.Row="3" Background="{DynamicResource CardBgBrush}" Padding="20,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Spacing="5">
                        <TextBlock Text="MultiSych v1.0.0-beta" FontSize="11" Foreground="{DynamicResource SubTextBrush}" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="RAM Kullanımı:" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                            <TextBlock Name="RamUsageText" Text="Hesaplanıyor..." FontSize="11" Foreground="#4CAF50" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Ana İçerik Alanı (Content Area) -->
        <Grid Grid.Column="1" RowDefinitions="*, Auto" Background="{DynamicResource MainBgBrush}">
            <!-- Seçili Sayfanın Yükleneceği Kısım -->
            <TransitioningContentControl Grid.Row="0" Content="{Binding CurrentPageViewModel}">
                <TransitioningContentControl.PageTransition>
                    <PageSlide Duration="0:0:0.35" Orientation="Horizontal" />
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
            
            <!-- Tema Değiştirme Butonu (MVVM Command ile) -->
            <Button Grid.Row="0" Content="🌓" Command="{Binding ToggleThemeCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20" Padding="10" CornerRadius="20" Background="{DynamicResource SecondaryButtonBgBrush}" Foreground="{DynamicResource TextBrush}" ToolTip.Tip="Aydınlık / Karanlık Tema" ZIndex="100"/>
            
            <!-- Alt Durum Çubuğu -->
            <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" Padding="15,5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SubTextBrush}" FontSize="12"/>
            </Border>
        </Grid>
    </Grid>
</Window>
