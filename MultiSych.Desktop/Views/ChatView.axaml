<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MultiSych.Desktop.ViewModels"
             xmlns:converters="using:MultiSych.Desktop.Converters"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             x:Class="MultiSych.Desktop.Views.ChatView"
             x:DataType="vm:ChatViewModel">
    
    <!-- Herhangi bir Converter kullanmadan Avalonia Classes (CSS benzeri) ile balonları dinamik hizalıyoruz -->
    <UserControl.Resources>
        <converters:StringToTextDocumentConverter x:Key="StringToTextDocumentConverter" />
        <converters:LanguageToSyntaxHighlightingConverter x:Key="LanguageToSyntaxHighlightingConverter" />
    </UserControl.Resources>
    
    <UserControl.Styles>
        <Style Selector="Border.userBubble">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Background" Value="#0078D7" />
        </Style>
        <Style Selector="Border.aiBubble">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="#2D2D30" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*, Auto">
        <ScrollViewer Grid.Row="0" Margin="10">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="5,5,5,15" Padding="12" CornerRadius="8"
                                Classes.userBubble="{Binding IsUser}"
                                Classes.aiBubble="{Binding !IsUser}"
                                MaxWidth="600">
                            <StackPanel>
                                <TextBlock Text="{Binding SenderName}" FontWeight="Bold" FontSize="11" Foreground="#CCCCCC" Margin="0,0,0,4"/>
                                
                                <!-- Metin ve Kod bloklarını ayrı ayrı çizen iç ItemsControl -->
                                <ItemsControl ItemsSource="{Binding Segments}">
                                    <ItemsControl.DataTemplates>
                                        <DataTemplate x:DataType="vm:TextSegment">
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="White" FontSize="14" />
                                        </DataTemplate>
                                        <DataTemplate x:DataType="vm:CodeSegment">
                                            <Border Background="#1E1E1E" CornerRadius="4" Padding="10" Margin="0,5">
                                                <ae:TextEditor
                                                    Document="{Binding Code, Converter={StaticResource StringToTextDocumentConverter}}"
                                                    SyntaxHighlighting="{Binding Language, Converter={StaticResource LanguageToSyntaxHighlightingConverter}}"
                                                    IsReadOnly="True"
                                                    ShowLineNumbers="True"
                                                    FontFamily="Consolas, Menlo, monospace"
                                                    FontSize="13"
                                                    Background="Transparent"
                                                    MaxHeight="400"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.DataTemplates>
                                </ItemsControl>
                                <TextBlock Text="{Binding Time}" FontSize="10" Foreground="#999999" HorizontalAlignment="Right" Margin="5,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="1" ColumnDefinitions="*, Auto, Auto" Margin="10">
            <TextBox Grid.Column="0" Text="{Binding InputText}" Watermark="Yapay Zeka'ya mesajınızı yazın..." VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Content="{Binding RecordButtonText}" Command="{Binding ToggleRecordingCommand}" Width="40" HorizontalContentAlignment="Center" Margin="5,0,0,0" ToolTip.Tip="Sesle Dikte Et" />
            <Button Grid.Column="2" Content="Gönder" Command="{Binding SendCommand}" Margin="5,0,0,0" Classes="accent" IsEnabled="{Binding !IsBusy}" />
        </Grid>
    </Grid>
</UserControl>