<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <system:String x:Key="SettingsTitle">Settings</system:String>
    <system:String x:Key="AutoSyncLabel">Enable Auto Synchronization (AutoSync)?</system:String>
    <system:String x:Key="SyncIntervalLabel">Sync Interval (Minutes):</system:String>
    <system:String x:Key="ApiKeysTitle">AI Provider API Keys</system:String>
    <system:String x:Key="SaveSettingsBtn">💾 Save Settings</system:String>
    <system:String x:Key="LiveLogsTitle">Live System Logs (Debug)</system:String>

    <system:String x:Key="DashboardTitle">Overview</system:String>
    <system:String x:Key="RefreshBtn">🔄 Refresh</system:String>
    <system:String x:Key="TotalAccountsLabel">Total Accounts</system:String>
    <system:String x:Key="TotalEmailsLabel">Synced Emails</system:String>
    <system:String x:Key="TotalEventsLabel">Calendar Events</system:String>
    <system:String x:Key="TotalFilesLabel">Cloud Files</system:String>
</ResourceDictionary>
