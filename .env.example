# Copy this file to .env and fill in your credentials

# Google OAuth2 Credentials
# Get from: https://console.developers.google.com
# NOT: Kod şu an bu değeri OKUMUYOR, yönlendirme adresi sabit
# "http://localhost:5000/" (2026-09-27'de doğrulandı, docs/KARARLAR.md).
# Google Cloud Console'da "Authorized redirect URIs" alanına TAM OLARAK
# http://localhost:5000/ yaz — buradaki değer değil.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Graph / Outlook Credentials
# Get from: https://portal.azure.com
# Aynı not: yönlendirme adresi sabit "http://localhost:5000/".
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Yandex OAuth2 Credentials
# Get from: https://oauth.yandex.com
# Aynı not: yönlendirme adresi sabit "http://localhost:5000/".
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Database Configuration
# NOT (K28, 2026-10-12): DATABASE_PATH, LOG_LEVEL, ENABLE_SYNC_ON_STARTUP
# aşağıda — kod şu an bunların HİÇBİRİNİ okumuyor, DB yolu her zaman
# sabit ~/.config/MultiSych/multisych.db. Gerçek çalışan değişkenler:
MULTISYCH_ENCRYPT_STORAGE=true
MULTISYCH_STORAGE_PASSWORD=

# Application Settings
# NOT (K28): SYNC_INTERVAL_MINUTES/ENABLE_SYNC_ON_STARTUP eskiden burada
# yanlış adla duruyordu ve hiç okunmuyordu — Ayarlar ekranından
# kaydedilen senkron aralığı bu yüzden her açılışta sessizce kayboluyordu
# (düzeltildi, bkz. docs/KARARLAR.md K28). Gerçek çalışan adlar:
MULTISYCH_SYNC_INTERVAL=15
MULTISYCH_AUTO_SYNC=true
