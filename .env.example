# Copy this file to .env and fill in your credentials

# Google OAuth2 Credentials
# Get from: https://console.developers.google.com
# NOT: Kod şu an bu değeri OKUMUYOR, yönlendirme adresi sabit
# "http://localhost:5000/" (2026-09-27'de doğrulandı, docs/KARARLAR.md).
# Google Cloud Console'da "Authorized redirect URIs" alanına TAM OLARAK
# http://localhost:5000/ yaz — buradaki değer değil.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Graph / Outlook Credentials
# Get from: https://portal.azure.com
# Aynı not: yönlendirme adresi sabit "http://localhost:5000/".
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Yandex OAuth2 Credentials
# Get from: https://oauth.yandex.com
# Aynı not: yönlendirme adresi sabit "http://localhost:5000/".
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Database Configuration
DATABASE_PATH=~/.config/MultiSych/multisych.db
ENCRYPT_STORAGE=true
STORAGE_PASSWORD=

# Application Settings
LOG_LEVEL=Information
ENABLE_SYNC_ON_STARTUP=false
SYNC_INTERVAL_MINUTES=30
