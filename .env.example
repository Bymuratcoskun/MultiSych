# Copy this file to .env and fill in your credentials

# Google OAuth2 Credentials
# Get from: https://console.developers.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/callback/google

# Microsoft Graph / Outlook Credentials  
# Get from: https://portal.azure.com
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:5000/callback/microsoft

# Yandex OAuth2 Credentials
# Get from: https://oauth.yandex.com
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:5000/callback/yandex

# Database Configuration
DATABASE_PATH=~/.config/MultiSych/multisych.db
ENCRYPT_STORAGE=true
STORAGE_PASSWORD=

# Application Settings
LOG_LEVEL=Information
ENABLE_SYNC_ON_STARTUP=false
SYNC_INTERVAL_MINUTES=30
